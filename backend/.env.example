LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# Explicit dispatch target for roomConfig.agents
AGENT_NAME=lemonslice-salary-coach

LEMONSLICE_API_KEY=your_lemonslice_api_key
MISTRAL_API_KEY=your_mistral_api_key
# Eleven Labs: API key from https://elevenlabs.io/app/settings/api-keys (not voice_id)
# Preferred for LiveKit plugin: ELEVEN_API_KEY
# Compatibility fallback is supported in config.py: ELEVENLABS_API_KEY
ELEVEN_API_KEY=your_eleven_api_key

# Optional model/runtime tuning
MISTRAL_MODEL=mistral-small-latest
ELEVEN_STT_MODEL=scribe_v2_realtime
ELEVEN_TTS_MODEL=eleven_turbo_v2_5
ELEVEN_TTS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVEN_TTS_STREAMING_LATENCY=4
ELEVEN_TTS_SYNC_ALIGNMENT=false
ELEVEN_LANGUAGE_CODE=en
ELEVEN_VALIDATE_STT_RUNTIME=false
ELEVEN_SERVER_VAD_ENABLED=true
ELEVEN_SERVER_VAD_THRESHOLD=0.72
ELEVEN_SERVER_VAD_SILENCE_THRESHOLD_SECS=0.45
ELEVEN_SERVER_VAD_MIN_SPEECH_DURATION_MS=420
ELEVEN_SERVER_VAD_MIN_SILENCE_DURATION_MS=500

TOKEN_TTL_MINUTES=15
IDLE_SILENCE_SECONDS=7
AVATAR_REGISTRY_PATH=./avatar_registry.yaml

# Anti-noise turn detection tuning (helps ignore fan/background noise)
VAD_ACTIVATION_THRESHOLD=0.84
VAD_DEACTIVATION_THRESHOLD=0.70
VAD_MIN_SPEECH_SECONDS=0.40
VAD_MIN_SILENCE_SECONDS=0.38
VAD_PREFIX_PADDING_SECONDS=0.35
MIN_ENDPOINTING_DELAY=0.12
MAX_ENDPOINTING_DELAY=0.6
PREEMPTIVE_GENERATION=true
ALLOW_INTERRUPTIONS=true
MIN_INTERRUPTION_DURATION=0.9
MIN_INTERRUPTION_WORDS=2
WORKER_NUM_IDLE_PROCESSES=1
